@model List<Quize_app.Models.Question>

@{
    ViewData["Title"] = "Take Quiz";
}

<div class="quiz-container">
    <div class="quiz-header">
        <h1>🎯 Knowledge Quiz</h1>
        <p class="quiz-subtitle">Test your knowledge with @Model.Count questions</p>
    </div>

    <form asp-action="Submit" method="post" id="quizForm">
        <div class="questions-wrapper">
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="question-card">
                    <div class="question-number">Question @(i + 1) of @Model.Count</div>
                    <h3 class="question-text">@Model[i].questionTest</h3>

                    <div class="options-container">
                        <label class="option-label">
                            <input type="radio" name="answers[@i]" value="A" required />
                            <span class="option-content">
                                <span class="option-letter">A</span>
                                <span class="option-text">@Model[i].optionA</span>
                            </span>
                        </label>

                        <label class="option-label">
                            <input type="radio" name="answers[@i]" value="B" required />
                            <span class="option-content">
                                <span class="option-letter">B</span>
                                <span class="option-text">@Model[i].optionB</span>
                            </span>
                        </label>

                        <label class="option-label">
                            <input type="radio" name="answers[@i]" value="C" required />
                            <span class="option-content">
                                <span class="option-letter">C</span>
                                <span class="option-text">@Model[i].optionC</span>
                            </span>
                        </label>

                        <label class="option-label">
                            <input type="radio" name="answers[@i]" value="D" required />
                            <span class="option-content">
                                <span class="option-letter">D</span>
                                <span class="option-text">@Model[i].optionD</span>
                            </span>
                        </label>
                    </div>
                </div>
            }
        </div>

        <div class="submit-container">
            <button type="submit" class="submit-btn">
                Submit Quiz
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M4 10h12m-6-6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </div>
    </form>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px;
    }

    .quiz-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .quiz-header {
        text-align: center;
        margin-bottom: 40px;
        color: white;
    }

        .quiz-header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            font-weight: 700;
        }

    .quiz-subtitle {
        font-size: 1.1rem;
        opacity: 0.95;
    }

    .questions-wrapper {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .question-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .question-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
        }

    .question-number {
        color: #667eea;
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
    }

    .question-text {
        color: #2d3748;
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 24px;
        line-height: 1.5;
    }

    .options-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .option-label {
        cursor: pointer;
        display: block;
    }

        .option-label input[type="radio"] {
            display: none;
        }

    .option-content {
        display: flex;
        align-items: center;
        padding: 16px 20px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.3s ease;
        background: #f7fafc;
    }

    .option-label:hover .option-content {
        border-color: #667eea;
        background: #edf2f7;
        transform: translateX(4px);
    }

    .option-label input[type="radio"]:checked + .option-content {
        border-color: #667eea;
        background: linear-gradient(135deg, #667eea15, #764ba215);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
    }

    .option-letter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: #667eea;
        color: white;
        font-weight: 700;
        font-size: 1rem;
        margin-right: 16px;
        flex-shrink: 0;
    }

    .option-label input[type="radio"]:checked + .option-content .option-letter {
        background: linear-gradient(135deg, #667eea, #764ba2);
    }

    .option-text {
        color: #2d3748;
        font-size: 1rem;
        line-height: 1.5;
    }

    .submit-container {
        margin-top: 40px;
        text-align: center;
    }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        border: none;
        padding: 18px 48px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
    }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(102, 126, 234, 0.5);
        }

        .submit-btn:active {
            transform: translateY(0);
        }

    
</style>